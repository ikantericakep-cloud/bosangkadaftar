            top: -20%;
            width: 320px;
            height: 150%;
            background: linear-gradient(to bottom, rgba(255,40,40,0.22), transparent 60%);
            clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
            filter: blur(28px);
            opacity: 0.6;
            animation: beamMove 8s infinite alternate ease-in-out;
            z-index: -1;
        }

        .beam-left { left: -12%; transform-origin: top; }
        .beam-right { right: -12%; transform-origin: top; animation-delay: -4s; }

        /* Debu halus */
