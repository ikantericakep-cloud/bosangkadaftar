        /* Tombol utama — pastikan teks kontras (putih) */
        .btn-daftar {
            display: block;
            width: 85%;
            max-width: 360px;
            margin: 12px auto;
            padding: 14px 18px;
            text-decoration: none;
            font-weight: 900;
            font-size: 1.05rem;
            border-radius: 999px;
            text-align: center;
            position: relative;
            overflow: hidden;
            color: #ffffff; /* teks putih agar selalu terlihat */
            background: linear-gradient(180deg, #560000 0%, #220000 100%);
            border: 1px solid rgba(255,80,80,0.12);
            transition: transform .25s ease, box-shadow .25s ease;
            box-shadow: 0 8px 30px rgba(200,20,20,0.25);
            z-index: 2;
        }

        /* Aksen border berputar merah */
        .btn-daftar::before {
            content: '';
            position: absolute;
            top: -60%;
            left: -60%;
            width: 220%;
            height: 220%;
            background: conic-gradient(transparent, rgba(255,60,60,0.95), rgba(140,10,10,0.9), transparent 30%);
            animation: rotate-border 3.5s linear infinite;
            z-index: 0;
            filter: blur(6px);
            opacity: 0.95;
        }

        /* Lapisan dalam tombol */
        .btn-daftar::after {
            content: '';
            position: absolute;
            inset: 3px;
            background: linear-gradient(180deg, rgba(150,0,0,0.85) 0%, rgba(40,0,0,0.95) 100%);
            border-radius: 999px;
            z-index: 1;
            transition: background .25s ease;
        }

        /* Memastikan teks selalu di depan */
        .btn-daftar span {
            position: relative;
            z-index: 3;
            pointer-events: none;
            color: #fff;
            text-shadow: 0 3px 10px rgba(0,0,0,0.45);
            display: inline-block;
